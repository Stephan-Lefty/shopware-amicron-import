<?xml version="1.0" encoding="iso-8859-1"?>
<!-- Import Definition für Shopware V4.1, Dez 2013, Version 0.95, AD -->

<ORDERS>
    <DEFINES>
        <!-- Dokumentation dieser Einstellungen: siehe Kapitel "Datenimport > Auftragsimport > Definitionsdatei: Aufbau und Inhalt"-->
        <DECIMALSEPARATOR>.</DECIMALSEPARATOR>
        <!-- Konvertierung der Landeskürzel ist für Amicron-Faktura notwendig für die korrekte Ermittlung der Steuerkürzel bei  Auslandsrechnungen. -->
        <!-- Importierte Landeskürzel für Inland und EU-Länder müssen übereinstimmen mit denen, die in der Faktura in -->
        <!-- den Programmoptionen unter "System > Einstellungen 2/2" eingetragen wurden -->
        <INLAND>D,DE,DEU,DEUTSCHLAND,GER,GERMANY</INLAND>
        <CONVERTLAND>AUT=A,AUS=A,Austria=A,AU=A,GERMANY=D,DE=D,GER=D,Netherlands=NL,France=FR,Slovenia=SL,Switzerland=CH,Spain=E,Greece=GR</CONVERTLAND>
    </DEFINES>
    <ORDER>
        <!-- die Shop-Bestellnummer ins FREIFELD1 (Vermerk),
             das Bestelldatum ins FREIFELD2 (Bestellung vom) und
             der Shop-Domainname des Auftrags ins FREIFELD3 (Bestellart)
             werden übernommen
             Bei Bedarf können die geändert werden: -->
        <id NewData="AUFTRAG">#AUFTRAGNR</id>
        <number>#FREIFELD1</number>
        <customerId>#KUNADRESSE.NR</customerId>
        <!-- <invoiceShipping>#VERSANDKOSTEN</invoiceShipping> -->
		<invoiceAmount>#AUFRAG.ENDBETRAG</invoiceAmount>
        <versandKosten>#VERSANDKOSTEN</versandKosten>
        <invoiceShippingTax>#VERSANDKOSTENSTEUER</invoiceShippingTax>
        <orderTime>#DATUM</orderTime>
        <orderDatum>#FREIFELD2</orderDatum>
        <shopURL>#FREIFELD3</shopURL>
        <comment>#BEMERKUNG</comment>
        <internalComment>#KUNADRESSE.BEMERKUNG</internalComment>
        <steuerInkl>#STEUERINKL</steuerInkl>
        <currency>#WAEHRUNG</currency>
        <details>
            <item NewData="ATRPOS">
                 <articleNumber>#ATRPOS.ARTIKELNR</articleNumber>
                 <price>#ATRPOS.EPREIS</price>
                 <quantity>#ATRPOS.MENGE</quantity>
                 <articleName>#ATRPOS.BEZEICHNUNG</articleName>
                 <taxRate>#ATRPOS.STEUER</taxRate>
            </item>
        </details>
        <payment>
             <description>#AUFTRAG.ZAHLWEISE</description>
        </payment>
        <groupKey>#KUNADRESSE.GRUPPE</groupKey>
        <priceGroupId>#KUNADRESSE.PREISGRUPPE</priceGroupId>
        <email>#KUNADRESSE.EMAIL</email>
        <debit>
             <account>#KUNADRESSE.BANKKTONR</account>
             <bankCode>#KUNADRESSE.BLZ</bankCode>
             <bankName>#KUNADRESSE.BANK</bankName>
             <accountHolder>#KUNADRESSE.KONTOINHABER</accountHolder>
	</debit>
        <billing NewData="KUNADRESSE">
             <company>#NAME2</company>
             <department>#NAME3</department>
             <salutation>#ANREDE</salutation>
             <firstName>#VORNAME</firstName>
             <lastName>#NAME</lastName>
             <street>#STRASSE</street>
             <zipCode>#PLZ</zipCode>
             <city>#ORT</city>
             <phone>#TELEFON1</phone>
             <fax>#FAX</fax>
             <vatId>#USTIDNR</vatId>
             <countryiso>#LAND</countryiso>
        </billing>
        <shipping NewData="LFRADRESSE">
             <company>#NAME2</company>
             <department>#NAME3</department>
             <salutation>#ANREDE</salutation>
             <firstName>#VORNAME</firstName>
             <lastName>#NAME</lastName>
             <street>#STRASSE</street>
             <zipCode>#PLZ</zipCode>
             <city>#ORT</city>
             <countryiso>#LAND</countryiso>
        </shipping>
        <dispatch>
             <name>#AUFTRAG.LIEFERART</name>
        </dispatch>
    </ORDER>
</ORDERS>
